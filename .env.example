# Copy this file to .env and fill in your own values. Never commit .env.

# From @BotFather on Telegram
BOT_TOKEN=123456789:your-bot-token

# Your personal Telegram chat ID. Only this chat can use the bot.
CHAT_ID=your-chat-id

# Optional: the only chat allowed to see your portfolio. Defaults to CHAT_ID.
# Keep this set if you ever clear CHAT_ID to share the bot with others.
# OWNER_CHAT_ID=your-chat-id

# From https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key

# Optional: comma-separated models, tried in order
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3.5-lightning:free

# Optional: paid DeepSeek fallback, used only when the free OpenRouter models fail
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# Optional: heartbeat (start-up message, daily check-in, stall warnings). On by default.
# HEARTBEAT_ENABLED=1
# Hour of the daily check-in in the VM's local time (0-23). Default 7.
# HEARTBEAT_HOUR=7
