# Copy this file to .env and fill in your own values. Never commit .env.

# From @BotFather on Telegram
BOT_TOKEN=123456789:your-bot-token

# Your personal Telegram chat ID. Only this chat can use the bot.
CHAT_ID=your-chat-id

# From https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your-key

# Optional: comma-separated models, tried in order
# OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free,nvidia/nemotron-3.5-lightning:free
